<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_esqueci_senha"
    android:background="#F7EDDA"
    android:layout_width="match_parent"
    android:paddingTop="30dp"
    android:layout_height="match_parent"
    tools:context=".EsqueciSenhaActivity">

    <!-- Logo Vangust Burguer -->
    <LinearLayout
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo_vangust_burguer" />
    </LinearLayout>

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar Senha"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#8F572F"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Insira o seu e-mail cadastrado para receber uma nova senha temporária."
        android:textSize="14sp"
        android:textColor="#5C3A21"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp"/>

    <!-- Campo E-mail -->
    <LinearLayout
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            app:endIconMode="clear_text"
            app:endIconTint="#8F572F"
            app:startIconDrawable="@drawable/baseline_person"
            app:startIconTint="#8F572F"
            app:boxStrokeColor="#8F572F"
            app:hintTextColor="#8F572F"
            app:cursorColor="#8F572F">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txEmailEsqueci"
                android:inputType="textEmailAddress"
                android:maxLength="50"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Botão Enviar -->
    <LinearLayout
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnEnviarRecuperacao"
            android:text="Enviar Senha Temporária"
            android:textColor="#F7EDDA"
            android:backgroundTint="#8F572F"
            app:cornerRadius="10dp"/>
    </LinearLayout>

</LinearLayout>