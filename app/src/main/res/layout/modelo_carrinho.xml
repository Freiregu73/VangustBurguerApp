<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FCD299"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Imagem do Produto no Carrinho -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="10dp">

            <ImageView
                android:id="@+id/imgItemCarrinho"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="#2c2c2c" /> <!-- Aqui entrará a imagem real do hambúrguer -->
        </androidx.cardview.widget.CardView>

        <!-- Detalhes do Produto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_regular"
                android:text="Vangust Clássico"
                android:textColor="#8F572F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrecoCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_regular"
                android:text="R$ 34,90"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Controlos de Quantidade (+ e -) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp">

            <!-- Ícone de Menos (pode importar um baseline_remove no Vector Asset se não tiver) -->
            <ImageView
                android:id="@+id/btnDiminuirQtd"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/baseline_remove"
                app:tint="#A61C1C"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvQuantidadeCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/oswald_regular"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Ícone de Mais (usando o mesmo do formulário de endereços) -->
            <ImageView
                android:id="@+id/btnAumentarQtd"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/baseline_add"
                app:tint="#A61C1C"
                android:padding="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>