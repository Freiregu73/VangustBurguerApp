<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_vangust_burguer"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_com_fundo"
        android:supportsRtl="true"
        android:theme="@style/Theme.VangustApp">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MenuPrincipalActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CadastroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CupomFragment"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NovoEndereco"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerfilFragment"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditarPerfil"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DetalhesPedidos"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>