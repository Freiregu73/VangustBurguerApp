<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EDDA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_regular"
            android:text="Resumo do Pedido"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Bloco de Endereço -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FCD299"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereço de Entrega"
                    android:textStyle="bold"
                    android:textColor="#8F572F"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvEnderecoCheckout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A carregar endereço..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bloco de Métodos de Pagamento -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FCD299"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Método de Pagamento"
                    android:textStyle="bold"
                    android:textColor="#8F572F"
                    android:textSize="18sp"
                    android:layout_marginBottom="10dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupPagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PIX"
                        android:textColor="@color/black"/>

                    <RadioButton
                        android:id="@+id/rbCartao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cartão (Crédito/Débito na entrega)"
                        android:textColor="@color/black"/>

                    <RadioButton
                        android:id="@+id/rbDinheiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dinheiro"
                        android:textColor="@color/black"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bloco de Resumo de Valores -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FCD299"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total a Pagar (com taxa)"
                    android:textStyle="bold"
                    android:textColor="#8F572F"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvTotalCheckout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botão de Confirmar Pedido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarPedidoFinal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#A61C1C"
            android:text="Confirmar Pedido"
            app:cornerRadius="10dp"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>