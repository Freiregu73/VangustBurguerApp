<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_alterar_senha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EDDA"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Barra Superior -->
    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/btnVoltarAlterarSenha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/baseline_arrow_back"
            app:tint="#8F572F"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Alterar Senha"
            android:textColor="#8F572F"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <!-- Campo Senha Atual -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#8F572F"
            app:hintTextColor="#8F572F"
            app:endIconTint="#8F572F"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txSenhaAtual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Senha Atual"
                android:inputType="textPassword"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Nova Senha -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#8F572F"
            app:hintTextColor="#8F572F"
            app:endIconTint="#8F572F"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txNovaSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nova Senha (mín. 6 caracteres)"
                android:inputType="textPassword"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botão Salvar Nova Senha -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarNovaSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Atualizar Senha"
            android:textColor="#F7EDDA"
            android:textSize="16sp"
            app:backgroundTint="#8F572F"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>