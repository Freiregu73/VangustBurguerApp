<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modeloCardProdutos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FCD299"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="350dp">
            <ImageView
                android:id="@+id/modeloImagemProdutos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="#2c2c2c"
                android:scaleType="centerCrop"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/modeloTituloProdutos"
                android:text="Titulo Burguer"
                android:fontFamily="@font/oswald_regular"
                android:layout_gravity="center_horizontal"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>

            <TextView
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/modeloDescricaoProdutos"
                android:text="Lorem ipsum hambúrguer artesanal smashed burger bacon crocante maionese da casa cheddar derretido. Blend de angus pão de brioche tostado na manteiga alface americana tomate fresco cebola roxa caramelizada. Costela desfiada picles crocante barbecue defumado anéis de cebola queijo prato duplo smash smashburger suculento."
                android:fontFamily="@font/roboto_condensed_light"
                android:layout_gravity="center_horizontal"
                android:padding="15dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$"
                    android:fontFamily="@font/oswald_regular"
                    android:layout_gravity="center"
                    android:textSize="26sp"
                    android:layout_marginLeft="20dp"/>

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/modeloPrecoProdutos"
                    android:text="23,99"
                    android:fontFamily="@font/oswald_regular"
                    android:layout_gravity="center"
                    android:textSize="26sp"
                    android:layout_marginLeft="5dp"
                    />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedir"
                    android:layout_marginLeft="170dp"
                    android:layout_gravity="center"
                    android:backgroundTint="#A61C1C"/>
            </LinearLayout>




        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>