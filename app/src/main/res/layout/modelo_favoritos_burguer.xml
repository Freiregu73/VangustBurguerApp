<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modeloCardFavoritos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FCD299"
        android:padding="12dp">

        <!-- Imagem do Hambúrguer (Lado Esquerdo) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImgFavoritos"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/modeloImagemFavoritos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="#2c2c2c" />
        </androidx.cardview.widget.CardView>

        <!-- Título do Hambúrguer -->
        <TextView
            android:id="@+id/modeloTituloFavoritos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/oswald_regular"
            android:text="Titulo Burguer"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardImgFavoritos"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Descrição do Hambúrguer -->
        <TextView
            android:id="@+id/modeloDescFavoritos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_condensed_light"
            android:text="Hambúrguer parrudo de 180g, cheddar derretido e bacon crocante."
            android:textColor="@color/black"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/modeloTituloFavoritos"
            app:layout_constraintStart_toEndOf="@id/cardImgFavoritos"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Preço -->
        <TextView
            android:id="@+id/modeloPrecoFavoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_condensed_black"
            android:text="R$ 34,99"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/modeloDescFavoritos"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardImgFavoritos" />

        <!-- Botão Pedir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeloBtnFavoritos"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Pedir"
            android:textColor="#F7EDDA"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#A61C1C"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/modeloDescFavoritos" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>